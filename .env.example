# Fahrlehrerin Sarah – Umgebungskonfiguration
# Kopiere diese Datei nach ".env" und passe die Werte an.

# Anwendung
APP_ENV=local
APP_DEBUG=true
APP_NAME="Fahrlehrerin Sarah"

# Basis-Pfad, unter dem die App ausgeliefert wird.
# Root-Domain:      BASE_PATH=
# Demo-Subfolder:   BASE_PATH=/demo/fahrlehrerin-sarah
BASE_PATH=

# Datenbank (SQLite – kein Datenbankserver nötig)
# Leer lassen = Standardpfad storage/database.sqlite
DB_SQLITE_PATH=

# Sarahs Zugang zur Verwaltung (wird von scripts/migrate.php angelegt)
ADMIN_EMAIL=sarah@fahrlehrerin-sarah.de
ADMIN_PASSWORD=sarah12345

# --- Sarahs Arbeitgeberin ------------------------------------------------
# Sarah ist ANGESTELLTE Fahrlehrerin. Anmeldung, Vertrag und Preise laufen
# über ihre Fahrschule, nicht über diese Seite.
# SCHOOL_NAME leer lassen = die Fahrschule wird nirgends namentlich genannt.
# Standardmäßig leer – erst eintragen, wenn die Fahrschule zugestimmt hat.
SCHOOL_NAME=
SCHOOL_URL=

# Terminregeln (Sarahs persönliche Stundenplanung)
# Bis wie viele Stunden vor Beginn dürfen Schüler:innen absagen/verschieben?
CANCEL_DEADLINE_HOURS=24
# Standarddauer einer Fahrstunde in Minuten
SLOT_DURATION_MIN=45

# Sarahs eigene Kanäle (jeweils nur der Handle, ohne @ und ohne Share-Parameter)
TIKTOK_HANDLE=fahrlehrerin_sarah
INSTAGRAM_HANDLE=fahrlehrerinsarah

# Kontaktdaten (erscheinen im Footer und auf der Kontaktseite)
CONTACT_PHONE="0123 456789"
CONTACT_EMAIL=hallo@fahrlehrerin-sarah.de
# Hauptstandort (kurz, taucht in Überschriften und Meta-Beschreibung auf)
CONTACT_CITY="Neu Wulmstorf"
# Einzugsgebiet, Orte mit Komma trennen
CONTACT_AREA="Neu Wulmstorf, Buxtehude, Stade, Hamburg"

# E-Mail (Benachrichtigungen)
# In der Demo wird statt echtem Versand nur nach storage/mail.log geschrieben:
MAIL_DRIVER=log
MAIL_TO=hallo@fahrlehrerin-sarah.de
MAIL_FROM=noreply@fahrlehrerin-sarah.de
