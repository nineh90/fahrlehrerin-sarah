# Fahrlehrerin Sarah – Umgebungskonfiguration
# Kopiere diese Datei nach ".env" und passe die Werte an.

# Anwendung
APP_ENV=local
APP_DEBUG=true
APP_NAME="Fahrlehrerin Sarah"

# Die öffentliche Adresse der Seite, OHNE abschließenden Schrägstrich.
# Braucht jede absolute URL, die nicht aus einem Request entsteht: Canonical,
# Sitemap, strukturierte Daten – und später Mails aus einem Cronjob.
# Leer lassen ist erlaubt: Dann rät absolute_url() den Host aus dem Request,
# wie bisher. Lokal reicht das, im Betrieb nicht – dort ist die Seite über IP
# UND Domain erreichbar, und geraten wird dann mal die eine, mal die andere.
# Genau davor schützt der Canonical, also darf er nicht selbst raten.
APP_URL=https://fahrlehrerinsarah.de

# Basis-Pfad, unter dem die App ausgeliefert wird.
# Root-Domain:      BASE_PATH=

# Darf die Seite in Suchmaschinen auftauchen?
# false = jede Seite trägt "noindex, nofollow" und /robots.txt sperrt alles.
# Solange die Seite nur zum Zeigen online steht, bleibt das auf false.
# ERST ZUM LIVEGANG auf true.
ALLOW_INDEXING=false
# Demo-Subfolder:   BASE_PATH=/demo/fahrlehrerin-sarah
BASE_PATH=

# Datenbank (SQLite – kein Datenbankserver nötig)
# Leer lassen = Standardpfad storage/database.sqlite
DB_SQLITE_PATH=

# Sarahs Zugang zur Schaltzentrale (wird von scripts/migrate.php angelegt)
# ACHTUNG: Diese Adresse wird nur BEIM AUFSETZEN übernommen. Steht der Zugang
# einmal in der Tabelle `admins`, ändert eine neue Adresse hier gar nichts mehr.
# Nachträglich umstellen geht über die Datenbank, nicht über migrate.php – das
# Skript setzt das Schema neu auf und nimmt alle Daten mit (Befehl in der README).
ADMIN_EMAIL=sarah@fahrlehrerinsarah.de
ADMIN_PASSWORD=sarah12345

# Muss Sarah beim ersten Anmelden ein eigenes Passwort vergeben?
#
# ACHTUNG im Testbetrieb: Steht das auf true, wird jede:r beim ersten Login
# zwangsweise auf die Passwortseite geleitet. Wer dort ein eigenes Passwort
# vergibt, sperrt damit alle anderen aus – auch dich.
# Deshalb solange false, wie mehrere Leute mit demselben Zugang testen.
#
# VOR DEM LIVEGANG auf true setzen. ADMIN_PASSWORD ist dann ein Einmalpasswort:
# einen zufälligen Wert eintragen, Sarah persönlich geben, sie vergibt beim
# ersten Anmelden ihr eigenes. So steht ihr echtes Passwort nie in einer Datei.
ADMIN_FORCE_PASSWORD_CHANGE=false

# --- Sarahs Arbeitgeberin ------------------------------------------------
# Sarah ist ANGESTELLTE Fahrlehrerin. Anmeldung, Vertrag und Preise laufen
# über ihre Fahrschule, nicht über diese Seite.
# SCHOOL_NAME leer lassen = die Fahrschule wird nirgends namentlich genannt.
# Gefüllt = sie wird genannt und überall dort verlinkt, wo es um Anmeldung,
# Vertrag oder Preise geht. Seit 07.08.2026 gefüllt: Sarahs Fahrschule wird
# auf der Seite bewusst genannt, weil die Anmeldung dorthin läuft.
SCHOOL_NAME="Fahrschule Sander"
SCHOOL_URL=https://www.fahrschule-sander.de/

# Terminregeln (Sarahs persönliche Stundenplanung)
#
# ZEIGT DIE WEBSITE DIE TERMINPLANUNG? Seit dem 21.08.2026 nicht (SAR-54):
# Sarahs Fahrschule bekommt ab September ein neues System, das Termine wohl
# selbst freigeben kann. Bis das geklärt ist, führt von der Seite kein Weg
# mehr dorthin – kein Menüpunkt, kein Knopf, kein Link im Fuß.
#
# Weg ist damit nur der WEG: Routen, Controller, Views und der ganze
# Admin-Bereich bleiben und funktionieren. Auf true gesetzt, stehen alle
# Links wieder da, wo sie waren.
TERMINE_OEFFENTLICH=false
# Bis wie viele Stunden vor Beginn dürfen Schüler:innen absagen/verschieben?
CANCEL_DEADLINE_HOURS=24
# Standarddauer einer Fahrstunde in Minuten
SLOT_DURATION_MIN=45

# Sarahs eigene Kanäle (jeweils nur der Handle, ohne @ und ohne Share-Parameter)
TIKTOK_HANDLE=fahrlehrerin_sarah
INSTAGRAM_HANDLE=fahrlehrerinsarah

# Kontaktdaten stehen NICHT hier, sondern in app/config.php.
#
# Sie sind keine Umgebungskonfiguration: Telefon, E-Mail, Ort und Einzugsgebiet
# sind auf dem Entwicklungsrechner dieselben wie auf dem Server. Was überall
# gleich ist, gehört in den Code – dort bringt der Deploy es automatisch mit,
# und es kann nicht auseinanderlaufen.
#
# Genau das war vorher der Fall: Die echte Dienstnummer stand seit SAR-66 in
# config.php, die .env überschrieb sie mit einem Platzhalter, und die Seite
# zeigte den Platzhalter. Zwei Quellen, von denen die schlechtere gewinnt.
#
# Ändern also in app/config.php unter 'contact'. Die env()-Aufrufe dort bleiben
# als Notausgang bestehen – wer einen Wert wirklich je Umgebung braucht, kann
# ihn hier wieder setzen und weiß dann, dass er damit den Code übersteuert.

# E-Mail (Benachrichtigungen)
#
# log  = schreibt nur nach storage/mail.log, es geht nichts raus. Der richtige
#        Wert zum Entwickeln: So liegt lokal kein Passwort und niemand bekommt
#        beim Ausprobieren echte Mails.
# smtp = echter Versand über ein angemeldetes Postfach. Der Weg im Betrieb.
# mail = PHP mail(). ACHTUNG: Im Container dieses Projekts gibt es kein
#        Mailprogramm, damit schlägt der Versand lautlos fehl.
MAIL_DRIVER=log
MAIL_TO=sarah@fahrlehrerinsarah.de
MAIL_FROM=sarah@fahrlehrerinsarah.de
# Klarname vor der Adresse. Leer = nur die Adresse.
MAIL_FROM_NAME="Fahrlehrerin Sarah"
# Wohin Antworten gehen, wenn das nicht MAIL_FROM sein soll. Gedacht für den
# Fall, dass aus einer Adresse gesendet wird, die niemand liest.
MAIL_REPLY_TO=

# --- SMTP (nur nötig bei MAIL_DRIVER=smtp) -------------------------------
# Angemeldet beim Anbieter des Postfachs verlässt die Mail dessen Server, und
# für den stimmen SPF und DKIM der Domain bereits. Vom VPS selbst zu senden
# ist keine Alternative: eine frische IP ohne Ruf, und ausgerechnet die
# PIN-Mail landet im Spam.
#
# SMTP_PASSWORD gehört NUR in die .env auf dem Server – nie ins Repo, nie in
# einen Chat. Die Datei ist gitignored, liegt außerhalb des Webroots und wird
# vom Deploy nicht angefasst. Empfohlen: chmod 640, Gruppe 33.
#
# GOOGLE WORKSPACE (der Weg dieses Projekts seit dem Umzug, 28.08.2026):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_SECURITY=tls
#   SMTP_USER=<die Postfachadresse>
#   SMTP_PASSWORD=<App-Passwort, NICHT das Kontopasswort>
#
# Zwei Dinge, an denen es sonst scheitert:
#
# 1. Das App-Passwort gibt es erst NACH dem Einschalten der Zweifaktor-
#    Anmeldung für dieses Konto. Ohne 2FA blendet Google die Funktion gar
#    nicht ein – es sieht dann aus, als könne man keine erzeugen.
#    Das normale Kontopasswort weist Google an dieser Stelle ab.
#
# 2. MAIL_FROM muss eine Adresse sein, unter der das angemeldete Konto
#    senden DARF – also das Postfach selbst oder ein dort eingerichteter
#    Alias. Steht dort etwas anderes, lehnt Google den Absender ab, und
#    zwar erst beim Senden, nicht beim Anmelden.
#
# Der Grund, warum überhaupt der Anbieter des Postfachs sendet, steht oben:
# SPF und DKIM der Domain zeigen auf ihn. Nach einem Umzug des Postfachs
# gilt das für den alten Anbieter NICHT mehr – dessen Mail fällt dann durch
# die SPF-Prüfung, auch wenn die Anmeldung dort noch funktioniert.
SMTP_HOST=
# 465 = tls, 587 = starttls
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# tls | starttls | none  – "none" nur im eigenen Netz, sonst geht das
# Passwort offen über die Leitung.
SMTP_SECURITY=tls

# --- Benachrichtigungen an Sarah -----------------------------------------
# Trägt sich jemand ein, verschiebt oder sagt ab, landet das IMMER im
# Posteingang der Schaltzentrale (/admin/benachrichtigungen). Zusätzlich:
#
# E-Mail an Sarah (nutzt MAIL_DRIVER, im Demo-Betrieb also nur mail.log)
NOTIFY_MAIL=true
# Leer lassen = an MAIL_TO
NOTIFY_TO=
#
# Mails an die Fahrschüler:innen selbst. Zwei Anlässe:
#   1. die PIN, sobald Sarah sie erzeugt
#   2. wenn SARAH etwas an einer Stunde ändert – absagt, verschiebt oder eine
#      zuweist. Wer das nicht erfährt, steht sonst am Treffpunkt.
# Was die Person selbst auslöst, bekommt sie nicht gemailt – das weiß sie.
# Auf false setzen, solange echte Adressen in der Datenbank stehen, aber noch
# nichts rausgehen soll.
NOTIFY_STUDENT_MAIL=true
#
# Webhook für Automatisierung – n8n, Make, Zapier o.ä. Bekommt die Rohdaten
# als JSON (inkl. starts_at/ends_at im ISO-Format, direkt kalendertauglich).
# Von dort aus lässt sich alles Weitere bauen: Kalendereintrag, Push,
# WhatsApp. Leer = kein Versand nach außen.
NOTIFY_WEBHOOK_URL=
# Optional: Ist ein Secret gesetzt, geht die HMAC-Signatur des JSON-Bodys
# als Header "X-Signature: sha256=..." mit, damit der Empfänger die Herkunft
# prüfen kann.
NOTIFY_WEBHOOK_SECRET=
