# Zugangsdaten und Kontaktdaten – .env.example bleibt die Vorlage im Repo
.env*
!.env.example

# Laufzeitdaten. Database.php nutzt WAL, dabei entstehen -wal und -shm daneben.
storage/*
!storage/.gitkeep

# Sarahs Rohfotos von der Messe. Das Repo ist öffentlich – Aufnahmen einer realen
# Person gehören da nicht hinein, und auf beiden steht „FAHRSCHULE SANDER" auf dem
# Stehtisch. Die Zuschnitte, die auf der Website laufen, liegen in public/assets/img.
# Die Logo-Master daneben bleiben im Repo, sonst lassen sich die Ableitungen nicht bauen.
assets-quellen/fahrlehrerin_sarah.jpeg
assets-quellen/fahrlehrerin_sarah_ausgeschnitten.png
assets-quellen/sarah-rollistammtisch.jpeg
assets-quellen/fahrlehrerin_sarah_hero.jpeg

# Die drei Aufnahmen vom 31.08.2026 (SAR-110). Hier wiegt der Grund von oben
# noch schwerer: Auf zwei von ihnen ist NICHT NUR SARAH zu sehen, sondern eine
# Kollegin und ein Fahrschüler – erkennbar, in voller Auflösung, aus einer
# Fahrstunde. Das gehört in kein öffentliches Repo. Die verkleinerten
# Zuschnitte, die auf der Website laufen, liegen wie immer in
# public/assets/img und sind dort ohne EXIF abgelegt.
assets-quellen/fahrlehrerin_sarah_und_kollegin.jpeg
assets-quellen/fahrlehrerin_sarah_fahrstunde_handicap.jpeg
assets-quellen/fahrlehrerin_sarah_fahrschulauto_sander_handicap_ausbildung.jpeg

# Vorlage des Fahrschulautos: eine Folie aus dem Theoriematerial der Fahrschule,
# also deren Material und nicht Sarahs. Der ausgelieferte Freisteller
# (public/assets/img/fahrschulauto.webp) steht ohnehin auf der Website – die
# Originalfolie muss deshalb nicht zusätzlich in einem öffentlichen Repo liegen.
# Sie bleibt lokal, damit sich der Freisteller neu bauen lässt.
assets-quellen/fahrschulwagen_sander_fahrlehrerin_sarah.jpeg

# Die Vorlage des Neurodivergenz-Schaubilds (SAR-114). Eine fremde Grafik,
# als Bildschirmfoto geliefert, Herkunft und Lizenz ungeklärt – das Repo ist
# öffentlich. Auf der Website läuft sie ohnehin nicht: Dort steht der Nachbau
# in HTML und CSS (.spektrum). Die Datei bleibt lokal liegen, damit man
# vergleichen kann, wovon der Nachbau abstammt.
assets-quellen/fahrlehrerin_sarah_hero_neurodivergenz.jpeg

# Interne Arbeitsdokumente. Das Repo ist öffentlich; die CLAUDE.md nennt außerdem den
# Namen der Fahrschule im Klartext. Die Dateien bleiben lokal im Kundenordner liegen.
# texte-von-sarah.md sammelt ihre eigenen Texte im Wortlaut – auch die, die noch nicht
# auf der Seite stehen. Unveröffentlichte Entwürfe einer realen Person gehören nicht in
# ein öffentliches Repo.
CLAUDE.md
projekt.md
texte-von-sarah.md
# Ticketentwürfe, die noch nicht im System der Kundin stehen. Nennen Namen und
# internen Ablauf, gehören also nicht in ein öffentliches Repo.
ticket-*.md

