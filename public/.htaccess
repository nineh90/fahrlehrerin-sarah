# Alle Anfragen an existierende Dateien direkt ausliefern,
# alles andere an den Front Controller (index.php) weiterleiten.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Vorhandene Dateien/Verzeichnisse nicht umschreiben (Assets)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Alles Übrige an den Front Controller
    RewriteRule ^ index.php [L]
</IfModule>

# Verzeichnis-Listing deaktivieren
Options -Indexes

# Zugriff auf sensible Dateien blockieren
<FilesMatch "\.(env|sql|sqlite|md|log)$">
    Require all denied
</FilesMatch>

# Der Container schickt "X-Content-Type-Options: nosniff" mit. Kommt eine
# Schrift mit falschem Typ an, lehnt der Browser sie deshalb kommentarlos ab
# und die Seite fällt auf Courier zurück. Debian kennt woff2 seit Jahren – die
# Zeile ist die Versicherung dagegen, dass irgendwann ein Image ohne diesen
# Eintrag darunterliegt.
<IfModule mod_mime.c>
    AddType font/woff2 .woff2
</IfModule>

# Die Schriften liegen seit dem Wechsel weg von Google Fonts hier lokal. Sie
# ändern sich praktisch nie – ein Jahr Cache spart bei jedem Folgebesuch vier
# Anfragen. CSS und JS bewusst kürzer, die ändern sich bei jedem Deploy.
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType font/woff2               "access plus 1 year"
    ExpiresByType image/webp               "access plus 1 month"
    ExpiresByType image/jpeg               "access plus 1 month"
    ExpiresByType image/png                "access plus 1 month"
    ExpiresByType image/svg+xml            "access plus 1 month"
    ExpiresByType video/mp4                "access plus 1 month"
    ExpiresByType text/css                 "access plus 1 day"
    ExpiresByType application/javascript   "access plus 1 day"
</IfModule>
